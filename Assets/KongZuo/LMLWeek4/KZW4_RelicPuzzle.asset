  title: "\u7B2C\u4E00\u6392\u4E03\u5EA7\u4E0A\u653E\u8FC7\u4EC0\u4E48\u9057\u7269\uFF1F"
  explanation: "\u7559\u5EA7\u620F\u5BA3\u4F20\u518C\u63D0\u5230\u4E86\u4EA1\u8005\u9057\u7269\u3002\u65E7\u7167\u7247\u5BF9\u4F4D\u540E\uFF0C\u786E\u8BA4\u7269\u54C1\u4F4D\u4E8E\u4E03\u53F7\u5EA7\uFF1B\u7ED3\u5408\u5468\u660E\u751F\u7684\u573A\u52A1\u8BB0\u5F55\u4F5C\u7B54\u3002"
  options:
  - "\u4E00\u4E32\u620F\u697C\u94A5\u5319"
  - "\u65E7\u5DE5\u724C"
  - "\u94DC\u54E8"
  correctChoice: 1
  wrongFeedback: "\u7269\u4EF6\u5F62\u72B6\u548C\u573A\u52A1\u8BB0\u5F55\u4E0D\u7B26\uFF0C\u8BF7\u518D\u6838\u5BF9\u7167\u7247\u3002"
  correctFeedback: "\u786E\u5B9A\u4E86\uFF1A\u5468\u660E\u751F\u7684\u94A5\u5319\u4E32\u66FE\u88AB\u6446\u5728\u7B2C\u4E00\u6392\u4E03\u5EA7\u3002"
